
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CatalogApp.ViewModels"
        x:Class="CatalogApp.Views.AddCrewWindow"
        x:DataType="vm:AddCrewViewModel"
        Title="{Binding WindowTitle}"
        Width="450"
        Height="330"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          Margin="20"
          RowSpacing="16">

        <TextBlock Grid.Row="0"
                   Text="{Binding FormTitle}"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Text="Машина" />
            <ComboBox ItemsSource="{Binding Machines}"
                      SelectedItem="{Binding SelectedMachine}"
                      PlaceholderText="Выберите машину">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Brand}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <CheckBox Grid.Row="3"
                  Content="Активен"
                  IsChecked="{Binding IsActive}" />

        <StackPanel Grid.Row="2" Spacing="5">
            <TextBlock Text="Водитель" />
            <ComboBox ItemsSource="{Binding Drivers}"
                      SelectedItem="{Binding SelectedDriver}"
                      PlaceholderText="Выберите водителя">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FullName}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}" />
            <Button Content="Отмена"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
